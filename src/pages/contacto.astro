---
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { siteConfig, siteImages } from "../data/site";
import { areas } from "../data/areas";

const siteUrl = Astro.site ?? new URL(siteConfig.url);
const thankYouUrl = new URL("/gracias/", siteUrl).toString();
---

<Layout
  title={`Contacto | ${siteConfig.name}`}
  description="Contacta a Cristian Gutiérrez para casos legales y migratorios, proyectos culturales, alianzas de negocio o experiencias turísticas, con atención online"
  image={siteImages.contact}
  imageAlt="Cristian Gutiérrez disponible para una consulta online internacional"
  preloadImage={{
    src: siteImages.contact,
    sizes: "(min-width: 1024px) 480px, calc(100vw - 32px)",
  }}
>
  <div class="page-shell">
    <section class="section section-split">
      <div class="about-copy">
        <span class="eyebrow">Contacto</span>
        <h1>Hablemos de tu <span class="serif-italic">caso o proyecto</span></h1>
        <p>
          Cuéntame qué necesitas, en qué país estás y si tienes alguna fecha importante
        </p>

        <h2 class="sr-only">Datos de contacto</h2>
        <address class="contact-details">
          {siteConfig.email && <a href={siteConfig.contactUrl}>
            <Icon name="mail" />
            <span><small>Correo</small>{siteConfig.email}</span>
          </a>}
          <a href={siteConfig.instagram} target="_blank" rel="noopener noreferrer">
            <Icon name="instagram" />
            <span><small>Instagram</small>@tumultiversolegal</span>
          </a>
        </address>
      </div>
      <div class="about-image portrait-frame">
        <span class="portrait-back" aria-hidden="true"></span>
        <ResponsiveImage
          src={siteImages.contact}
          alt="Cristian Gutiérrez disponible para una consulta online internacional"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1024"
          height="1536"
          sizes="(min-width: 1024px) 480px, calc(100vw - 32px)"
        />
        <span class="portrait-stamp" aria-hidden="true">Consulta<br />internacional</span>
      </div>
    </section>

    {siteConfig.email ? <section class="section section-dark">
      <div class="section-header">
        <p class="eyebrow">Formulario</p>
        <h2>¿En qué puedo ayudarte?</h2>
      </div>
      <form action={`https://formsubmit.co/${siteConfig.email}`} method="POST" accept-charset="UTF-8" class="contact-form">
        <input type="hidden" name="_subject" value="Nueva consulta desde la web de Cristian Gutiérrez" />
        <input type="text" name="_honey" class="form-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="hidden" name="_next" value={thankYouUrl} />

        <div class="form-grid">
          <label>
            <span>Nombre completo</span>
            <input type="text" name="name" autocomplete="name" required maxlength="120" placeholder="Tu nombre completo" />
          </label>

          <label>
            <span>Correo electrónico</span>
            <input type="email" name="email" autocomplete="email" required maxlength="254" placeholder="tucorreo@ejemplo.com" />
          </label>

          <label>
            <span>Área de interés</span>
            <select name="area" id="contact-area" required>
              <option value="">Selecciona un área</option>
              {areas.map((area) => <option value={area.name} data-slug={area.slug}>{area.name}</option>)}
              <option value="Otro / aún no lo sé">Otro / aún no lo sé</option>
            </select>
          </label>

          <label>
            <span>País donde estás</span>
            <input type="text" name="country" autocomplete="country-name" placeholder="Ejemplo: Colombia" />
          </label>
        </div>

        <label>
          <span>Mensaje</span>
          <textarea name="message" rows="6" required minlength="20" maxlength="5000" placeholder="Cuéntame qué necesitas, en qué punto estás y si tienes alguna fecha importante"></textarea>
        </label>

        <div class="privacy-consent">
          <input id="privacy-consent" type="checkbox" name="privacy_consent" value="Aceptado" required />
          <label for="privacy-consent">Acepto la <a href="/privacidad/">política de privacidad</a> y el uso de mis datos para responder esta consulta</label>
        </div>

        <div class="form-submit-row">
          <button type="submit" class="btn btn-primary" aria-describedby="privacy-note">Enviar consulta</button>
          <p id="privacy-note">Tu información se usa únicamente para revisar y responder tu consulta</p>
        </div>
      </form>
    </section> : <section class="section conversion-band">
      <div>
        <p class="eyebrow">Primera conversación</p>
        <h2>Escríbeme por Instagram</h2>
        <p>Indica si tu consulta es sobre migración, cultura, negocios o turismo y cuéntame qué necesitas resolver</p>
      </div>
      <a class="btn btn-primary" href={siteConfig.instagram} target="_blank" rel="noopener noreferrer">Enviar un mensaje <span aria-hidden="true">↗</span></a>
    </section>}
  </div>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const slug = new URLSearchParams(location.search).get("area");
    const select = document.querySelector<HTMLSelectElement>("#contact-area");
    if (!select || !slug) return;
    const option = Array.from(select.options).find((item) => item.dataset.slug === slug);
    if (option) select.value = option.value;
  });
</script>
