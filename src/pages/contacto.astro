---
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { siteConfig, siteImages } from "../data/site";
import { areas } from "../data/areas";

const siteUrl = Astro.site ?? new URL(siteConfig.url);
const thankYouUrl = new URL("/gracias/", siteUrl).toString();
---

<Layout
  title={`Contacto | ${siteConfig.name}`}
  description="Contacta a Cristian Gutiérrez para casos legales y migratorios, proyectos culturales, alianzas de negocio o experiencias turísticas, con atención online"
  image={siteImages.contact}
  imageAlt="Cristian Gutiérrez disponible para una consulta online internacional"
  preloadImage={{
    src: siteImages.contact,
    sizes: "(min-width: 1024px) 480px, calc(100vw - 32px)",
  }}
>
  <div class="page-shell">
    <section class="section section-split">
      <div class="about-copy" data-reveal>
        <span class="eyebrow">Contacto</span>
        <h1>Comparte tu caso o proyecto y recibe una primera lectura <span class="serif-italic">estratégica</span></h1>
        <p>
          Elige el área que mejor encaja, cuéntame tu objetivo y en qué punto estás, y preparo una primera respuesta
        </p>

        <h2 class="sr-only">Datos de contacto</h2>
        <div class="feature-grid feature-grid-2">
          <div class="feature-card">
            <span class="feature-icon"><Icon name="document" /></span>
            <h3>Correo</h3>
            <p><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
          </div>
          <div class="feature-card">
            <span class="feature-icon"><Icon name="calendar" /></span>
            <h3>Teléfono</h3>
            <p><a href={`tel:${siteConfig.phoneHref}`}>{siteConfig.phone}</a></p>
          </div>
        </div>
      </div>
      <div class="about-image portrait-frame" data-reveal style="--d:.12s">
        <span class="portrait-back" aria-hidden="true"></span>
        <ResponsiveImage
          src={siteImages.contact}
          alt="Cristian Gutiérrez disponible para una consulta online internacional"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="720"
          height="540"
          sizes="(min-width: 1024px) 480px, calc(100vw - 32px)"
        />
        <span class="portrait-stamp" aria-hidden="true">Consulta<br />internacional</span>
      </div>
    </section>

    <section class="section section-dark">
      <div class="section-header" data-reveal>
        <p class="eyebrow">Formulario</p>
        <h2>Mientras más claro sea el contexto, mejor será la primera respuesta</h2>
      </div>
      <form action={`https://formsubmit.co/${siteConfig.email}`} method="POST" accept-charset="UTF-8" class="contact-form" data-reveal>
        <input type="hidden" name="_subject" value="Nueva consulta desde la web de Cristian Gutiérrez" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value={thankYouUrl} />

        <div class="form-grid">
          <label>
            <span>Nombre completo</span>
            <input type="text" name="name" autocomplete="name" required placeholder="Tu nombre completo" />
          </label>

          <label>
            <span>Correo electrónico</span>
            <input type="email" name="email" autocomplete="email" required placeholder="tucorreo@ejemplo.com" />
          </label>

          <label>
            <span>Área de interés</span>
            <select name="area" id="contact-area" required>
              <option value="">Selecciona un área</option>
              {areas.map((area) => <option value={area.name} data-slug={area.slug}>{area.name}</option>)}
              <option value="Otro / aún no lo sé">Otro / aún no lo sé</option>
            </select>
          </label>

          <label>
            <span>País donde estás</span>
            <input type="text" name="country" autocomplete="country-name" placeholder="Ejemplo: Colombia" />
          </label>
        </div>

        <label>
          <span>Mensaje</span>
          <textarea name="message" rows="6" required placeholder="Explica tu objetivo, en qué punto estás y cualquier fecha, documento o duda importante"></textarea>
        </label>

        <div class="privacy-consent">
          <input id="privacy-consent" type="checkbox" name="privacy_consent" value="Aceptado" required />
          <label for="privacy-consent">Acepto la <a href="/privacidad/">política de privacidad</a> y el uso de mis datos para responder esta consulta</label>
        </div>

        <div class="form-submit-row">
          <button type="submit" class="btn btn-primary" aria-describedby="privacy-note">Enviar mi caso</button>
          <p id="privacy-note">Tu información se usa únicamente para revisar y responder tu consulta</p>
        </div>
      </form>
    </section>
  </div>
</Layout>

<script is:inline>
  // Preselect the area when arriving from an area page (/contacto/?area=slug)
  (() => {
    const slug = new URLSearchParams(location.search).get("area");
    const select = document.getElementById("contact-area");
    const option = slug && select && select.querySelector(`option[data-slug="${CSS.escape(slug)}"]`);
    if (option) option.selected = true;
  })();
</script>
