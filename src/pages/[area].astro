---
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../data/site";
import { areas, type Area, type AreaPage } from "../data/areas";

export function getStaticPaths() {
  return areas
    .filter((area) => area.page)
    .map((area) => ({ params: { area: area.slug }, props: { area } }));
}

const { area } = Astro.props as { area: Area };
const page = area.page as AreaPage;
const otherAreas = areas.filter((item) => item.slug !== area.slug);
const contactHref = `/contacto/?area=${area.slug}`;

const siteUrl = Astro.site ?? new URL(siteConfig.url);
const areaUrl = new URL(area.path, siteUrl);
const structuredData = [
  {
    "@type": "Service",
    "@id": new URL("#service", areaUrl).toString(),
    name: area.name,
    description: page.lede,
    areaServed: "Worldwide",
    provider: {
      "@id": new URL("/#person", siteUrl).toString(),
    },
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: area.name,
      itemListElement: page.services.map((service) => ({
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: service.title,
          description: service.description,
        },
      })),
    },
  },
  {
    "@type": "FAQPage",
    "@id": new URL("#faq", areaUrl).toString(),
    mainEntity: page.faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<Layout
  title={`${area.seoTitle} | ${siteConfig.name}`}
  description={page.lede}
  structuredData={structuredData}
>
  <div class="page-shell area-page" style={`--area-accent:${area.accent}`}>
    <header class="hero area-hero">
      <div class="hero-copy">
        <span class="eyebrow">{area.name}</span>
        <h1>{page.headline} <span class="serif-italic">{page.headlineAccent}</span></h1>
        <p class="hero-lede">{page.lede}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={contactHref}>Proponer un proyecto <span aria-hidden="true">→</span></a>
          <a class="btn btn-secondary" href="#servicios">Ver qué incluye</a>
        </div>
      </div>

      <div class="area-emblem">
        <div class="area-emblem-head">
          <span>Área de trabajo</span>
        </div>
        <span class="area-emblem-icon"><Icon name={area.icon} /></span>
        <p class="area-emblem-name">{area.nameLead}<br /><em>{area.nameTail}</em></p>
        <ul class="area-emblem-tags">
          {area.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>
    </header>

    <section class="section section-light">
      <div class="section-header">
        <p class="eyebrow">El enfoque</p>
        <h2>{page.introTitle}</h2>
        <p>{page.intro}</p>
      </div>
      <div class="audience-grid">
        {page.audiences.map((item, i) => (
          <article class="audience-card">
            <span class="feature-icon"><Icon name={item.icon} /></span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="servicios">
      <div class="section-header">
        <p class="eyebrow">Qué incluye</p>
        <h2>{area.seoTitle}</h2>
      </div>
      <div class="cards-grid services-grid">
        {page.services.map((service, i) => (
          <article class="service-card area-service-card">
            <div class="service-card-head">
              <span class="service-number">0{i + 1}</span>
              <span class="area-icon"><Icon name={area.icon} /></span>
            </div>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <span class="service-tag">{service.tag}</span>
          </article>
        ))}
      </div>
    </section>

    <section class="section deliverables-section">
      <div class="section-header">
        <p class="eyebrow">Qué recibes</p>
        <h2>Qué preparamos durante el trabajo</h2>
      </div>
      <div class="document-grid">
        {page.deliverables.map((item, i) => (
          <article class={`document-card document-card-${i + 1}`}>
            <div class="document-head">
              <strong>{area.label}</strong>
            </div>
            <span class="document-icon"><Icon name={item.icon} /></span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <div class="document-lines" aria-hidden="true"></div>
          </article>
        ))}
      </div>
    </section>

    <section class="section faq-section" id="faq">
      <div class="section-header section-header-center">
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2>Lo que suelen preguntar antes de empezar</h2>
      </div>
      <div class="faq-list">
        {page.faq.map((item, i) => (
          <details class="faq-item">
            <summary><span>0{i + 1}</span>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <p class="eyebrow">Otras áreas</p>
        <h2>También puedo ayudarte con</h2>
      </div>
      <div class="areas-grid areas-grid-compact">
        {otherAreas.map((item, i) => (
          <a class="area-card" href={item.path} style={`--area-accent:${item.accent}`}>
            <div class="area-card-head">
              <span class="area-icon"><Icon name={item.icon} /></span>
            </div>
            <h3>{item.nameLead}<br />{item.nameTail}</h3>
            <p>{item.summary}</p>
            <span class="area-link">Explorar <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </section>

    <section class="section section-contact">
      <div class="contact-card contact-card-wide">
        <div>
          <span class="eyebrow">Siguiente paso</span>
          <h2>Hablemos de tu proyecto</h2>
          <p>Comparte el contexto, los objetivos y en qué punto está el proyecto</p>
        </div>
        <div class="contact-card-actions">
          <a class="btn btn-primary" href={contactHref}>Escribirme <span aria-hidden="true">→</span></a>
          <a class="contact-email" href={siteConfig.contactUrl}>{siteConfig.contactLabel}</a>
        </div>
      </div>
    </section>
  </div>
</Layout>
