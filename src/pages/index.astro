---
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { siteConfig, siteImages } from "../data/site";
import { areas, umbrellaValues } from "../data/areas";
---

<Layout
  preloadImage={{
    src: siteImages.advisor,
    sizes: "(min-width: 1024px) 480px, calc(100vw - 32px)",
  }}
>
  <div class="page-shell home-shell">
    <header class="hero hub-hero" id="inicio">
      <div class="hero-copy">
        <span class="eyebrow">{siteConfig.name}</span>
        <h1>
          Asesoría legal y <span class="serif-italic">gestión de proyectos</span>
        </h1>
        <p class="hero-lede">
          Soy Cristian Gutiérrez y acompaño consultas migratorias, proyectos culturales, alianzas de negocio
          y experiencias turísticas, desde la primera conversación hasta la coordinación de los próximos pasos
        </p>

        <div class="hero-actions">
          <a class="btn btn-primary" href="#areas">Explorar áreas <span aria-hidden="true">↓</span></a>
          <a class="btn btn-secondary" href="/contacto/">Hablar con Cristian</a>
        </div>

        <nav class="hub-shortcuts" aria-label="Elige el servicio que necesitas">
          {areas.map((area) => <a href={area.path}>{area.label}<span aria-hidden="true">↗</span></a>)}
        </nav>
      </div>

      <div class="about-image portrait-frame">
        <span class="portrait-back" aria-hidden="true"></span>
        <ResponsiveImage
          src={siteImages.advisor}
          alt="Retrato profesional de Cristian Gutiérrez"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1024"
          height="1536"
          sizes="(min-width: 1024px) 480px, calc(100vw - 32px)"
        />
      </div>
    </header>

    <section class="section areas-section" id="areas">
      <div class="section-header">
        <p class="eyebrow">Áreas de trabajo</p>
        <h2>¿Qué necesitas resolver?</h2>
      </div>
      <div class="areas-grid">
        {areas.map((area) => (
          <a class="area-card" href={area.path} style={`--area-accent:${area.accent}`}>
            <div class="area-card-head">
              <span class="area-icon"><Icon name={area.icon} /></span>
            </div>
            <h3>{area.nameLead}<br />{area.nameTail}</h3>
            <p>{area.summary}</p>
            <span class="area-link">Ver {area.label.toLowerCase()} <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </section>

    <section class="section section-light">
      <div class="section-header">
        <p class="eyebrow">Cómo puedo ayudarte</p>
        <h2>Hablamos, definimos el trabajo y acordamos los siguientes pasos</h2>
        <p>
          Antes de empezar, revisamos qué necesitas y si puedo ayudarte, qué incluye el servicio y qué parte
          requiere la intervención de otros profesionales
        </p>
      </div>
      <div class="feature-grid">
        {umbrellaValues.map((item) => (
          <article class="feature-card">
            <span class="feature-icon"><Icon name={item.icon} /></span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section section-contact" id="contacto">
      <div class="contact-card contact-card-wide">
        <div>
          <span class="eyebrow">Siguiente paso</span>
          <h2>Cuéntame qué necesitas</h2>
          <p>Elige un área y explícame tu situación, aunque todavía no sepas por dónde empezar</p>
        </div>
        <div class="contact-card-actions">
          <a class="btn btn-primary" href="/contacto/">Escribirme <span aria-hidden="true">→</span></a>
          <a class="contact-email" href={siteConfig.contactUrl}>{siteConfig.contactLabel}</a>
        </div>
      </div>
    </section>
  </div>
</Layout>
