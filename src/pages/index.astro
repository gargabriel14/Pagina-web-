---
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { advisorStatement, siteConfig, siteImages } from "../data/site";
import { areas, umbrellaPillars, umbrellaSteps } from "../data/areas";
---

<Layout
  preloadImage={{
    src: siteImages.advisor,
    sizes: "(min-width: 1024px) 480px, calc(100vw - 32px)",
  }}
>
  <div class="page-shell home-shell">
    <header class="hero hub-hero" id="inicio">
      <div class="hero-copy" data-reveal>
        <span class="eyebrow">{siteConfig.name}</span>
        <h1>
          Gestión estratégica de <span class="serif-italic">oportunidades</span> y proyectos
        </h1>
        <p class="hero-lede">
          Un punto de encuentro entre personas, ideas, negocios, derecho y cultura. Cada área parte del mismo
          criterio: entender bien el objetivo, conectar a las personas correctas y avanzar con claridad
        </p>

        <div class="hero-actions">
          <a class="btn btn-primary" href="#areas">Explorar áreas <span aria-hidden="true">↓</span></a>
          <a class="btn btn-secondary" href="/contacto/">Hablar con Cristian</a>
        </div>

        <ul class="hub-pillars" aria-label="Ejes de trabajo">
          {umbrellaPillars.map((pillar) => <li>{pillar}</li>)}
        </ul>
      </div>

      <div class="about-image portrait-frame" data-reveal style="--d:.12s">
        <span class="portrait-back" aria-hidden="true"></span>
        <ResponsiveImage
          src={siteImages.advisor}
          alt="Retrato profesional de Cristian Gutiérrez"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1024"
          height="1536"
          sizes="(min-width: 1024px) 480px, calc(100vw - 32px)"
        />
        <span class="portrait-stamp" aria-hidden="true">Cuatro<br />áreas</span>
      </div>
    </header>

    <section class="section areas-section" id="areas">
      <div class="section-header" data-reveal>
        <p class="eyebrow">Áreas de trabajo</p>
        <h2>Cuatro áreas, un mismo criterio para hacer que las cosas avancen</h2>
      </div>
      <div class="areas-grid">
        {areas.map((area, i) => (
          <a class="area-card" href={area.path} style={`--area-accent:${area.accent}; --d:${i * 0.08}s`} data-reveal>
            <div class="area-card-head">
              <span class="area-icon"><Icon name={area.icon} /></span>
              <span class="service-number">0{i + 1}</span>
            </div>
            <h3>{area.nameLead}<br />{area.nameTail}</h3>
            <p>{area.summary}</p>
            <span class="area-tags">{area.tags.join(" · ")}</span>
            <span class="area-link">Explorar <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </section>

    <figure class="image-band" data-reveal>
      <ResponsiveImage
        src={siteImages.services}
        alt="Cristian Gutiérrez explicando una estrategia en una reunión de trabajo"
        loading="lazy"
        decoding="async"
        width="1536"
        height="960"
        sizes="(min-width: 1240px) 1180px, calc(100vw - 32px)"
      />
      <blockquote>
        <span>Principio de trabajo</span>
        <p>“{advisorStatement.quote}”</p>
        <figcaption>{siteConfig.name} · {siteConfig.tagline}</figcaption>
      </blockquote>
    </figure>

    <section class="section process-section">
      <div class="section-header" data-reveal>
        <p class="eyebrow">Cómo trabajo</p>
        <h2>Sea un trámite, un artista o una alianza, el método es el mismo</h2>
      </div>
      <div class="process-grid">
        {umbrellaSteps.map((step, i) => (
          <article class="process-card" data-reveal style={`--d:${i * 0.08}s`}>
            <span class="step-number">{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
            <span class="process-status">Fase {i + 1} de 3</span>
          </article>
        ))}
      </div>
    </section>

    <section class="section section-contact" id="contacto">
      <div class="contact-card contact-card-wide" data-reveal>
        <span class="contact-reference">Solicitud · CG-01</span>
        <div>
          <span class="eyebrow">Siguiente paso</span>
          <h2>Cuéntame qué tienes en mente y veamos por dónde empezar</h2>
          <p>Un caso legal, un proyecto creativo, una alianza o una experiencia: comparte el contexto y lo revisamos</p>
        </div>
        <div class="contact-card-actions">
          <a class="btn btn-primary" href="/contacto/">Escribirme <span aria-hidden="true">→</span></a>
          <a class="contact-email" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        </div>
      </div>
    </section>
  </div>
</Layout>
