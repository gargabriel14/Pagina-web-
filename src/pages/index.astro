---
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import {
  consultationDeliverables,
  decisionPoints,
  faqItems,
  processSteps,
  services,
  siteConfig,
  siteImages,
  trustSignals,
} from "../data/site";

const siteUrl = Astro.site ?? new URL(siteConfig.url);
const faqSchema = {
  "@type": "FAQPage",
  "@id": new URL("/#faq", siteUrl).toString(),
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<Layout
  title="Asesoría migratoria internacional | Cristian Gutiérrez"
  description="Asesoría migratoria internacional para evaluar visas, residencia, permisos y movilidad con una estrategia clara antes de iniciar el proceso"
  preloadImage={{
    src: siteImages.hero,
    sizes: "(min-width: 1024px) 560px, calc(100vw - 32px)",
  }}
  structuredData={faqSchema}
>
  <div class="page-shell page-shell-premium">
    
    <!-- HERO ULTRA PREMIUM CON EFECTOS DRAMÁTICOS -->
    <header class="hero hero-ultra-premium" id="inicio">
      
      <!-- Background Animado -->
      <div class="hero-bg-animation">
        <div class="gradient-orb gradient-orb-1"></div>
        <div class="gradient-orb gradient-orb-2"></div>
        <div class="gradient-orb gradient-orb-3"></div>
        <div class="grid-overlay"></div>
      </div>
      
      <!-- Partículas flotantes -->
      <div class="floating-particles">
        <span class="particle particle-1"></span>
        <span class="particle particle-2"></span>
        <span class="particle particle-3"></span>
        <span class="particle particle-4"></span>
        <span class="particle particle-5"></span>
      </div>
      
      <div class="hero-content-wrapper">
        <div class="hero-copy hero-copy-animated">
          <div class="eyebrow-badge">
            <span class="badge-line"></span>
            <span>Movilidad internacional con criterio</span>
          </div>
          
          <h1 class="hero-title-split">
            <span class="title-line title-line-1">Asesoría migratoria</span>
            <span class="title-line title-line-2">internacional para</span>
            <span class="title-line title-line-3 highlight-gold">avanzar con ruta clara</span>
          </h1>
          
          <p class="hero-description fade-in-up">
            Cristian Gutiérrez te ayuda a evaluar opciones, anticipar riesgos y ordenar los próximos pasos antes
            de invertir tiempo y dinero en un proceso migratorio
          </p>

          <div class="hero-actions hero-actions-animated">
            <a class="btn btn-primary btn-glow" href="/contacto/">
              <span class="btn-text">Evaluar mi caso</span>
              <span class="btn-icon"><Icon name="arrow-right" /></span>
              <span class="btn-shimmer"></span>
            </a>
            <a class="btn btn-secondary btn-border-glow" href="/servicios/">
              <span class="btn-text">Ver servicios</span>
              <span class="btn-icon"><Icon name="external-link" /></span>
            </a>
          </div>

          <div class="hero-proof hero-proof-animated" aria-label="Señales de confianza">
            {trustSignals.map((signal, index) => (
              <div class={`hero-stat stat-delay-${index}`}>
                <strong class="stat-value">{signal.value}</strong>
                <span class="stat-label">{signal.label}</span>
                <div class="stat-divider"></div>
              </div>
            ))}
          </div>
        </div>

        <div class="hero-visual hero-visual-premium">
          <div class="image-frame image-frame-animated">
            <ResponsiveImage
              src={siteImages.hero}
              alt="Asesor migratorio conversando con un cliente en su oficina"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width="840"
              height="620"
              sizes="(min-width: 1024px) 560px, calc(100vw - 32px)"
            />
            <div class="image-overlay-gradient"></div>
            <div class="image-border-glow"></div>
          </div>
          
          <div class="visual-callout visual-callout-float">
            <span class="callout-icon"><Icon name="star" /></span>
            <div class="callout-content">
              <span>Primera evaluación</span>
              <strong>Origen, destino, objetivo y próximos pasos</strong>
            </div>
          </div>
          
          <!-- Decorative elements -->
          <div class="decorative-line decorative-line-1"></div>
          <div class="decorative-line decorative-line-2"></div>
        </div>
      </div>
      
      <!-- Scroll indicator -->
      <div class="scroll-indicator">
        <span class="scroll-text">Descubre más</span>
        <div class="scroll-arrow">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
    </header>

    <!-- SERVICIOS CON CARDS PREMIUM ANIMADAS -->
    <section class="section section-dark section-services-premium" id="servicios">
      <div class="section-header section-header-animated">
        <span class="eyebrow-badge eyebrow-center">
          <span class="badge-line"></span>
          <span>Cómo puedo ayudarte</span>
        </span>
        <h2 class="section-title-premium">
          <span class="title-reveal">Una estrategia adaptada</span>
          <span class="title-reveal title-reveal-2">a tu objetivo migratorio</span>
        </h2>
        <div class="title-underline"></div>
      </div>
      
      <div class="cards-grid cards-grid-premium">
        {services.map((service, index) => (
          <article class={`service-card service-card-premium card-delay-${index}`}>
            <div class="card-number">
              <span>0{index + 1}</span>
            </div>
            <div class="service-icon service-icon-premium">
              <Icon name={service.icon} />
              <div class="icon-ring"></div>
              <div class="icon-glow"></div>
            </div>
            <h3 class="service-title-premium">{service.title}</h3>
            <p class="service-description-premium">{service.description}</p>
            <a href="/servicios/" class="card-link-premium">
              <span>Conocer más</span>
              <Icon name="arrow-right" />
              <div class="link-line"></div>
            </a>
            <div class="card-hover-effect"></div>
          </article>
        ))}
      </div>
    </section>

    <!-- DECISION SECTION CON LAYOUT DRAMÁTICO -->
    <section class="section section-dark section-decision-premium">
      <div class="decision-container-premium">
        <div class="decision-content">
          <div class="section-header section-header-left">
            <span class="eyebrow-badge">
              <span class="badge-line"></span>
              <span>Decisiones críticas</span>
            </span>
            <h2>La consulta está pensada para responder lo que realmente cambia el resultado</h2>
          </div>
          
          <div class="decision-list-premium">
            {decisionPoints.map((point, index) => (
              <div class={`decision-item-premium decision-delay-${index}`}>
                <span class="decision-icon">
                  <Icon name="check" />
                  <div class="check-ring"></div>
                </span>
                <p>{point}</p>
                <div class="decision-line"></div>
              </div>
            ))}
          </div>
        </div>
        
        <div class="decision-panel-premium">
          <div class="panel-content">
            <span class="eyebrow-badge eyebrow-light">Antes de avanzar</span>
            <h3>Evita avanzar con una ruta equivocada</h3>
            <p>
              Una decisión tomada con información incompleta puede consumir semanas, dinero y oportunidades
              que una evaluación temprana ayuda a proteger
            </p>
            <a class="btn btn-primary btn-large btn-glow" href="/contacto/">
              <span class="btn-text">Revisar mi caso</span>
              <span class="btn-icon"><Icon name="arrow-right" /></span>
              <span class="btn-shimmer"></span>
            </a>
          </div>
          <div class="panel-bg-gradient"></div>
          <div class="panel-border-glow"></div>
        </div>
      </div>
    </section>

    <!-- DELIVERABLES CON GRID INTERACTIVO -->
    <section class="section section-light section-deliverables-premium">
      <div class="section-header section-header-animated">
        <span class="eyebrow-badge eyebrow-center">
          <span class="badge-line"></span>
          <span>Qué recibes</span>
        </span>
        <h2 class="section-title-premium">
          <span class="title-reveal">Sales de la consulta con</span>
          <span class="title-reveal title-reveal-2 highlight-gold">una ruta accionable</span>
          <span class="title-reveal title-reveal-3">no con dudas nuevas</span>
        </h2>
        <div class="title-underline"></div>
      </div>
      
      <div class="feature-grid feature-grid-premium">
        {consultationDeliverables.map((item, index) => (
          <article class={`feature-card feature-card-premium feature-delay-${index}`}>
            <div class="feature-icon feature-icon-premium">
              <Icon name={item.icon} />
              <div class="icon-pulse-ring"></div>
            </div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <div class="card-corner-accent"></div>
          </article>
        ))}
      </div>
    </section>

    <!-- ABOUT SECTION CON PARALLAX -->
    <section class="section section-split section-about-premium">
      <div class="about-content-wrapper">
        <div class="about-copy about-copy-premium">
          <span class="eyebrow-badge">
            <span class="badge-line"></span>
            <span>Enfoque profesional</span>
          </span>
          <h2>Orientación directa, sin promesas vacías ni pasos innecesarios</h2>
          <p>
            Cada caso parte de tu situación real, el país de origen, el destino y el momento del proceso para que
            entiendas qué conviene revisar primero
          </p>

          <div class="feature-grid feature-grid-2 feature-grid-premium">
            <div class="feature-card feature-card-mini">
              <span class="feature-icon feature-icon-mini"><Icon name="check" /></span>
              <h3>Asesoría práctica</h3>
              <p>Escenarios, riesgos y pasos concretos explicados en lenguaje claro</p>
            </div>
            <div class="feature-card feature-card-mini">
              <span class="feature-icon feature-icon-mini"><Icon name="document" /></span>
              <h3>Documentación ordenada</h3>
              <p>Expedientes consistentes, completos y fáciles de revisar</p>
            </div>
          </div>
        </div>

        <div class="about-image about-image-premium">
          <div class="image-wrapper-parallax">
            <ResponsiveImage
              src={siteImages.advisor}
              alt="Asesor migratorio preparando una evaluación internacional en su oficina"
              loading="lazy"
              decoding="async"
              width="720"
              height="540"
              sizes="(min-width: 1024px) 480px, calc(100vw - 32px)"
            />
            <div class="parallax-overlay"></div>
          </div>
          <div class="image-frame-decorative"></div>
          <div class="floating-badge">
            <Icon name="star" />
            <span>Experiencia verificada</span>
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESO CON TIMELINE VERTICAL ANIMADA -->
    <section class="section section-light section-process-premium">
      <div class="section-header section-header-animated">
        <span class="eyebrow-badge eyebrow-center">
          <span class="badge-line"></span>
          <span>Método de trabajo</span>
        </span>
        <h2 class="section-title-premium">
          <span class="title-reveal">Un proceso diseñado para que</span>
          <span class="title-reveal title-reveal-2">sepas qué hacer después</span>
          <span class="title-reveal title-reveal-3">de cada conversación</span>
        </h2>
        <div class="title-underline"></div>
      </div>
      
      <div class="process-timeline-premium">
        {processSteps.map((step, index) => (
          <article class={`process-step-premium step-delay-${index}`}>
            <div class="step-marker">
              <span class="step-number-large">{step.number}</span>
              <div class="marker-ring"></div>
              <div class="marker-glow"></div>
            </div>
            <div class="step-content">
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
            <div class="step-line"></div>
          </article>
        ))}
      </div>
    </section>

    <!-- FAQ CON ACORDEON PREMIUM -->
    <section class="section section-dark section-faq-premium">
      <div class="section-header section-header-animated">
        <span class="eyebrow-badge eyebrow-center">
          <span class="badge-line"></span>
          <span>Preguntas frecuentes</span>
        </span>
        <h2 class="section-title-premium">Respuestas rápidas antes de agendar</h2>
        <div class="title-underline"></div>
      </div>
      
      <div class="faq-list-premium">
        {faqItems.map((item, index) => (
          <details class={`faq-item-premium faq-delay-${index}`}>
            <summary class="faq-summary-premium">
              <span class="faq-question">{item.question}</span>
              <span class="faq-icon">
                <span class="icon-plus"></span>
                <span class="icon-minus"></span>
              </span>
            </summary>
            <div class="faq-answer-wrapper">
              <p class="faq-answer">{item.answer}</p>
            </div>
            <div class="faq-divider"></div>
          </details>
        ))}
      </div>
    </section>

    <!-- CONTACTO CON CARD DRAMÁTICA -->
    <section class="section section-contact section-contact-premium" id="contacto">
      <div class="contact-card-premium">
        <div class="contact-bg-effects">
          <div class="contact-gradient-orb"></div>
          <div class="contact-grid-pattern"></div>
        </div>
        
        <div class="contact-content">
          <span class="eyebrow-badge eyebrow-light">
            <span class="badge-line"></span>
            <span>Siguiente paso</span>
          </span>
          
          <h2 class="contact-title">Cuéntame qué quieres lograr y revisemos por dónde empezar</h2>
          
          <p class="contact-description">
            Comparte tu país de origen, destino, objetivo y momento actual para preparar una primera lectura
            de tu situación
          </p>
          
          <ul class="contact-info-premium">
            <li>
              <span class="info-icon"><Icon name="mail" /></span>
              <div class="info-content">
                <strong>Correo</strong>
                <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
              </div>
            </li>
            <li>
              <span class="info-icon"><Icon name="phone" /></span>
              <div class="info-content">
                <strong>Teléfono</strong>
                <a href={`tel:${siteConfig.phoneHref}`}>{siteConfig.phone}</a>
              </div>
            </li>
            <li>
              <span class="info-icon"><Icon name="location" /></span>
              <div class="info-content">
                <strong>Modalidad</strong>
                <span>{siteConfig.locationLabel}</span>
              </div>
            </li>
          </ul>
          
          <div class="contact-actions-premium">
            <a class="btn btn-primary btn-extra-large btn-glow-intense" href="/contacto/">
              <span class="btn-text">Evaluar mi caso</span>
              <span class="btn-icon"><Icon name="arrow-right" /></span>
              <span class="btn-shimmer"></span>
            </a>
          </div>
        </div>
        
        <div class="contact-decoration">
          <div class="corner-accent corner-top-left"></div>
          <div class="corner-accent corner-bottom-right"></div>
        </div>
      </div>
    </section>
    
  </div>
  
  <!-- Estilos específicos para animaciones -->
  <style is:global>
    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-20px); }
    }
    
    @keyframes pulse-glow {
      0%, 100% { opacity: 0.5; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.05); }
    }
    
    @keyframes shimmer {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(100%); }
    }
    
    @keyframes gradient-shift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    
    @keyframes fade-in-up {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    @keyframes reveal-up {
      from { opacity: 0; transform: translateY(50px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    @keyframes scale-in {
      from { opacity: 0; transform: scale(0.9); }
      to { opacity: 1; transform: scale(1); }
    }
  </style>
</Layout>
