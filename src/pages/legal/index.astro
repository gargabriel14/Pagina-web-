---
import Icon from "../../components/Icon.astro";
import Layout from "../../layouts/Layout.astro";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
import {
  advisorStatement,
  consultationDeliverables,
  decisionPoints,
  destinations,
  faqItems,
  processSteps,
  services,
  siteConfig,
  siteImages,
  trustSignals,
} from "../../data/site";

const siteUrl = Astro.site ?? new URL(siteConfig.url);
const faqSchema = {
  "@type": "FAQPage",
  "@id": new URL("/legal/#faq", siteUrl).toString(),
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
const serviceTags = [
  "Requisitos · Rutas · Documentos",
  "Familia · Reunificación · Dependientes",
  "Estudio · Talento · Oportunidades",
  "Equipos · Traslados · Expansión",
];
---

<Layout
  title="Asesoría migratoria internacional | Tu Multiverso Legal"
  description="Asesoría migratoria internacional para evaluar visas, residencia, permisos y movilidad con una estrategia clara antes de iniciar el proceso"
  preloadImage={{
    src: siteImages.hero,
    sizes: "(min-width: 1024px) 600px, calc(100vw - 32px)",
  }}
  structuredData={faqSchema}
>
  <div class="page-shell home-shell">
    <header class="hero hero-dossier" id="inicio">
      <div class="hero-copy" data-reveal>
        <span class="eyebrow">Tu Multiverso Legal · Movilidad internacional</span>
        <h1>
          Tu proceso migratorio necesita una
          <span class="serif-italic">ruta clara</span>
        </h1>
        <p class="hero-lede">
          Tu Multiverso Legal transforma requisitos, alternativas y riesgos en un plan que puedas entender antes
          de invertir tiempo y dinero
        </p>

        <div class="hero-actions">
          <a class="btn btn-primary" href="/contacto/?area=legal">Evaluar mi caso <span aria-hidden="true">→</span></a>
          <a class="btn btn-secondary" href="/legal/servicios/">Ver servicios</a>
        </div>

        <div class="hero-proof" aria-label="Señales de confianza">
          {trustSignals.map((signal) => (
            <div class="hero-stat">
              <strong>{signal.value}</strong>
              <span>{signal.label}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="dossier-stage" data-reveal style="--d:.12s">
        <span class="dossier-shadow" aria-hidden="true"></span>
        <article class="dossier-card">
          <div class="dossier-head">
            <span>Expediente de movilidad</span>
            <strong>CG · 001</strong>
          </div>
          <div class="dossier-photo">
            <ResponsiveImage
              src={siteImages.hero}
              alt="Asesor de Tu Multiverso Legal atendiendo una consulta migratoria internacional"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width="1536"
              height="1024"
              sizes="(min-width: 1024px) 600px, calc(100vw - 32px)"
            />
            <span class="dossier-stamp">Primera<br />evaluación</span>
          </div>
          <div class="dossier-route" aria-label="Datos que se revisan en la evaluación">
            <span><small>Origen</small>Tu situación</span>
            <i aria-hidden="true"></i>
            <span><small>Destino</small>Tu objetivo</span>
            <i aria-hidden="true"></i>
            <span><small>Ruta</small>Próximos pasos</span>
          </div>
          <div class="dossier-barcode" aria-hidden="true"></div>
        </article>
      </div>
    </header>

    <div class="marquee" aria-label="Destinos que se evalúan con frecuencia">
      <div class="marquee-track">
        <div class="marquee-group">
          {destinations.map((place) => <span class="marquee-item">{place}<i aria-hidden="true">✦</i></span>)}
        </div>
        <div class="marquee-group" aria-hidden="true">
          {destinations.map((place) => <span class="marquee-item">{place}<i>✦</i></span>)}
        </div>
      </div>
    </div>

    <section class="section services-section" id="servicios">
      <div class="section-header" data-reveal>
        <p class="eyebrow">Cómo puedo ayudarte</p>
        <h2>Una estrategia adaptada a tu objetivo migratorio</h2>
      </div>
      <div class="cards-grid services-grid">
        {services.map((service, i) => (
          <article class={`service-card service-card-${i + 1}`} data-reveal style={`--d:${i * 0.08}s`}>
            <div class="service-card-head">
              <span class="service-number">0{i + 1}</span>
              <span class="service-icon"><Icon name={service.icon} /></span>
            </div>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <span class="service-tag">{serviceTags[i]}</span>
          </article>
        ))}
      </div>
    </section>

    <section class="section decision-section">
      <div class="decision-layout">
        <div class="decision-panel" data-reveal>
          <p class="eyebrow">Decisiones críticas</p>
          <h2>Resolvemos lo que realmente cambia tu estrategia</h2>
          <p>
            Cada respuesta se trabaja sobre tu perfil, tu origen y tu destino, no sobre ejemplos genéricos
          </p>
          <div class="decision-callout">
            <span>Antes de avanzar</span>
            <h3>Evita invertir en una ruta equivocada</h3>
            <p>Una evaluación temprana puede proteger semanas, dinero y oportunidades</p>
            <a class="btn btn-light" href="/contacto/?area=legal">Revisar mi caso <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="decision-list">
          {decisionPoints.map((point, i) => (
            <article class="decision-item" data-reveal style={`--d:${i * 0.07}s`}>
              <span class="decision-index">Pregunta 0{i + 1}</span>
              <div class="decision-check"><Icon name="check" /></div>
              <p>{point}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section deliverables-section">
      <div class="section-header" data-reveal>
        <p class="eyebrow">Qué recibes</p>
        <h2>Sales con una ruta accionable, no con dudas nuevas</h2>
      </div>
      <div class="document-grid">
        {consultationDeliverables.map((item, i) => (
          <article class={`document-card document-card-${i + 1}`} data-reveal style={`--d:${i * 0.08}s`}>
            <div class="document-head">
              <strong>Entregable 0{i + 1}</strong>
              <span>CG / DOSSIER</span>
            </div>
            <span class="document-icon"><Icon name={item.icon} /></span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <div class="document-lines" aria-hidden="true"></div>
          </article>
        ))}
      </div>
    </section>

    <figure class="image-band" data-reveal>
      <ResponsiveImage
        src={siteImages.services}
        alt="Asesor migratorio explicando una estrategia migratoria a una pareja"
        loading="lazy"
        decoding="async"
        width="1536"
        height="960"
        sizes="(min-width: 1240px) 1180px, calc(100vw - 32px)"
      />
      <blockquote>
        <span>Principio de trabajo</span>
        <p>“{advisorStatement.quote}”</p>
        <figcaption>{advisorStatement.name} · {advisorStatement.role}</figcaption>
      </blockquote>
    </figure>

    <section class="section section-split advisor-section">
      <div class="about-image portrait-frame" data-reveal>
        <span class="portrait-back" aria-hidden="true"></span>
        <ResponsiveImage
          src={siteImages.advisor}
          alt="Retrato profesional del equipo de Tu Multiverso Legal"
          loading="lazy"
          decoding="async"
          width="1024"
          height="1536"
          sizes="(min-width: 1024px) 470px, calc(100vw - 32px)"
        />
        <span class="portrait-stamp">Enfoque<br />profesional</span>
      </div>
      <div class="about-copy" data-reveal style="--d:.1s">
        <p class="eyebrow">Tu Multiverso Legal</p>
        <h2>Orientación directa, sin promesas vacías ni pasos innecesarios</h2>
        <p>
          Cada caso parte de tu situación real, el país de origen, el destino y el momento del proceso para
          entender qué conviene revisar primero
        </p>
        <div class="advisor-points">
          <div>
            <span>A / 01</span>
            <h3>Asesoría práctica</h3>
            <p>Escenarios, riesgos y pasos concretos explicados en lenguaje claro</p>
          </div>
          <div>
            <span>A / 02</span>
            <h3>Documentación ordenada</h3>
            <p>Expedientes consistentes, completos y fáciles de revisar</p>
          </div>
        </div>
        <a class="text-link" href="/sobre-mi/">Conocer a Cristian <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="section process-section">
      <div class="section-header" data-reveal>
        <p class="eyebrow">Método de trabajo</p>
        <h2>Un proceso diseñado para que sepas qué hacer después de cada conversación</h2>
      </div>
      <div class="process-grid">
        {processSteps.map((step, i) => (
          <article class="process-card" data-reveal style={`--d:${i * 0.08}s`}>
            <span class="step-number">{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
            <span class="process-status">Fase {i + 1} de 3</span>
          </article>
        ))}
      </div>
    </section>

    <section class="section faq-section" id="faq">
      <div class="section-header section-header-center" data-reveal>
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2>Respuestas rápidas antes de agendar</h2>
      </div>
      <div class="faq-list">
        {faqItems.map((item, i) => (
          <details class="faq-item" data-reveal style={`--d:${i * 0.05}s`}>
            <summary><span>0{i + 1}</span>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="section section-contact" id="contacto">
      <div class="contact-card contact-card-wide" data-reveal>
        <span class="contact-reference">Solicitud · CG-01</span>
        <div>
          <span class="eyebrow">Siguiente paso</span>
          <h2>Cuéntame qué quieres lograr y revisemos por dónde empezar</h2>
          <p>Comparte tu origen, destino, objetivo y momento actual para preparar una primera lectura</p>
        </div>
        <div class="contact-card-actions">
          <a class="btn btn-primary" href="/contacto/?area=legal">Evaluar mi caso <span aria-hidden="true">→</span></a>
          <a class="contact-email" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        </div>
      </div>
    </section>
  </div>
</Layout>
