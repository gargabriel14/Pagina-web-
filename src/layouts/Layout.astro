---
import "../styles/global.css";
import "@fontsource-variable/fraunces";
import "@fontsource-variable/instrument-sans";
import { ClientRouter, slide } from "astro:transitions";
import { siteConfig } from "../data/site";
import { areas } from "../data/areas";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  preloadImage?: {
    src: string;
    sizes: string;
  };
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = siteConfig.ogImage,
  imageAlt = siteConfig.ogImageAlt,
  preloadImage,
  structuredData,
  noindex = false,
} = Astro.props as Props;

const siteUrl = Astro.site ?? new URL(siteConfig.url);
const homeUrl = new URL("/", siteUrl).toString();
const normalizedPathname = Astro.url.pathname === "/" ? "/" : `${Astro.url.pathname.replace(/\/$/, "")}/`;
const pageUrl = new URL(normalizedPathname, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
const businessImageUrl = new URL(siteConfig.ogImage, siteUrl).toString();
const currentYear = new Date().getFullYear();
const currentPath = normalizedPathname.replace(/\/$/, "") || "/";
const optimizedWidths = [480, 720, 1080, 1400];
const getImageBaseName = (src: string) => (src.split("/").pop() ?? "").replace(/\.[^.]+$/, "");
const getOptimizedSrcset = (src: string, format: "avif" | "webp") => {
  const baseName = getImageBaseName(src);
  return optimizedWidths
    .map((imageWidth) => `/images/optimized/${baseName}-${imageWidth}.${format} ${imageWidth}w`)
    .join(", ");
};
const preloadImageHref = preloadImage
  ? `/images/optimized/${getImageBaseName(preloadImage.src)}-720.avif`
  : undefined;
const preloadImageSrcset = preloadImage ? getOptimizedSrcset(preloadImage.src, "avif") : undefined;
const isCurrent = (href: string) => {
  const normalizedHref = href.replace(/\/$/, "") || "/";
  return currentPath === normalizedHref;
};
const isInArea = (href: string) => `${currentPath}/`.startsWith(href);
const inAnyArea = areas.some((area) => isInArea(area.path));
const pageTransition = slide({ duration: "280ms" });
const websiteId = new URL("#website", homeUrl).toString();
const personId = new URL("#person", homeUrl).toString();
const webpageId = new URL("#webpage", pageUrl).toString();
const extraStructuredData = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const structuredDataGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: homeUrl,
      name: siteConfig.name,
      description: siteConfig.description,
      inLanguage: siteConfig.language,
    },
    {
      "@type": "Person",
      "@id": personId,
      name: siteConfig.name,
      url: homeUrl,
      description: siteConfig.description,
      jobTitle: siteConfig.tagline,
      image: businessImageUrl,
      email: siteConfig.email,
      telephone: siteConfig.phoneHref,
      sameAs: [siteConfig.instagram],
      knowsAbout: areas.map((area) => area.name),
    },
    {
      "@type": "WebPage",
      "@id": webpageId,
      url: pageUrl,
      name: title,
      description,
      inLanguage: siteConfig.language,
      primaryImageOfPage: imageUrl,
      isPartOf: {
        "@id": websiteId,
      },
    },
    ...extraStructuredData,
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1711" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    {
      preloadImageHref && preloadImageSrcset && (
        <link
          rel="preload"
          as="image"
          href={preloadImageHref}
          type="image/avif"
          imagesrcset={preloadImageSrcset}
          imagesizes={preloadImage?.sizes}
          fetchpriority="high"
        />
      )
    }

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {
      !noindex && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredDataGraph)} />
      )
    }
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <div class="topbar" transition:name="site-topbar" transition:animate="none">
      <div class="topbar-inner">
        <span>
          <strong>{siteConfig.name}</strong>
          <span class="topbar-dot" aria-hidden="true"></span>
          {siteConfig.tagline}
        </span>
        <span class="topbar-contact">
          <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        </span>
      </div>
    </div>
    <header class="header" transition:name="site-header" transition:animate="none">
      <nav class="navbar" aria-label="Navegación principal">
        <div class="nav-container">
          <a class="logo" href="/" aria-label={`${siteConfig.name} - Inicio`}>
            <img class="brand-mark" src={siteConfig.logo} alt="" width="40" height="40" />
            <span class="logo-text">Cristian <span class="logo-gold">Gutiérrez</span></span>
          </a>

          <ul class="nav-menu nav-menu-desktop">
            <li><a href="/" class="nav-link" aria-current={isCurrent("/") ? "page" : undefined}>Inicio</a></li>
            <li class="nav-dropdown">
              <a href="/#areas" class={`nav-link nav-dropdown-trigger${inAnyArea ? " is-active" : ""}`}>
                Áreas <span aria-hidden="true">▾</span>
              </a>
              <ul class="nav-submenu">
                {
                  areas.map((area) => (
                    <li>
                      <a
                        href={area.path}
                        class="nav-submenu-link"
                        style={`--area-accent:${area.accent}`}
                        aria-current={isInArea(area.path) ? "page" : undefined}
                      >
                        <strong>{area.name}</strong>
                        <span>{area.summary}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </li>
            <li><a href="/sobre-mi/" class="nav-link" aria-current={isCurrent("/sobre-mi/") ? "page" : undefined}>Sobre mí</a></li>
            <li>
              <a href="/contacto/" class="nav-link btn btn-primary" aria-current={isCurrent("/contacto/") ? "page" : undefined}>
                Contáctame
              </a>
            </li>
          </ul>

          <details class="nav-disclosure">
            <summary class="menu-toggle" aria-label="Abrir menú">
              <span></span>
              <span></span>
              <span></span>
            </summary>

            <ul class="nav-menu nav-menu-mobile">
              <li><a href="/" class="nav-link" aria-current={isCurrent("/") ? "page" : undefined}>Inicio</a></li>
              <li class="nav-mobile-label" aria-hidden="true">Áreas</li>
              {
                areas.map((area) => (
                  <li>
                    <a
                      href={area.path}
                      class="nav-link nav-link-area"
                      style={`--area-accent:${area.accent}`}
                      aria-current={isInArea(area.path) ? "page" : undefined}
                    >
                      {area.name}
                    </a>
                  </li>
                ))
              }
              <li><a href="/sobre-mi/" class="nav-link" aria-current={isCurrent("/sobre-mi/") ? "page" : undefined}>Sobre mí</a></li>
              <li>
                <a href="/contacto/" class="nav-link btn btn-primary" aria-current={isCurrent("/contacto/") ? "page" : undefined}>
                  Contáctame
                </a>
              </li>
            </ul>
          </details>
        </div>
      </nav>
    </header>

    <div class="page-stage" transition:name="page-content" transition:animate={pageTransition}>
      <main class="main-content" id="main-content">
        <slot />
      </main>

      <footer class="footer">
        <div class="footer-container">
          <div class="footer-grid footer-grid-main">
            <div class="footer-section footer-brand">
              <a class="footer-logo" href="/" aria-label={`${siteConfig.name} - Inicio`}>
                <img class="brand-mark" src={siteConfig.logo} alt="" width="40" height="40" loading="lazy" />
                <span class="footer-title">{siteConfig.name}</span>
              </a>
              <p>Personas, ideas, negocios, derecho y cultura: estrategia y conexiones para avanzar con claridad</p>
              <a class="footer-social" href={siteConfig.instagram} target="_blank" rel="noopener noreferrer">
                @tumultiversolegal <span aria-hidden="true">↗</span>
              </a>
            </div>

            <div class="footer-section">
              <h2 class="footer-subtitle">Áreas</h2>
              <ul class="footer-menu">
                {areas.map((area) => <li><a href={area.path}>{area.name}</a></li>)}
              </ul>
            </div>

            <div class="footer-section">
              <h2 class="footer-subtitle">Contacto</h2>
              <ul class="footer-contact">
                <li><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></li>
                <li><a href={`tel:${siteConfig.phoneHref}`}>{siteConfig.phone}</a></li>
                <li>{siteConfig.locationLabel}</li>
                <li><a href="/sobre-mi/">Sobre mí</a></li>
              </ul>
            </div>

            <div class="footer-section">
              <h2 class="footer-subtitle">Legal</h2>
              <ul class="footer-menu">
                <li><a href="/privacidad/">Política de privacidad</a></li>
                <li><a href="/terminos/">Términos y condiciones</a></li>
              </ul>
            </div>
          </div>

          <div class="footer-bottom">
            <p>&copy; {currentYear} {siteConfig.name} · Todos los derechos reservados</p>
          </div>
        </div>
      </footer>
    </div>

  </body>
</html>
